; Project the already transformed screen vertices and pass through UV and tint.
.fvec projection[4]
.out outpos position
.out outuv texcoord0
.out outcolor color
.in vertex v0
.in texcoord v1
.in color v2

.proc main
    dp4 outpos.x, projection[0], vertex
    dp4 outpos.y, projection[1], vertex
    dp4 outpos.z, projection[2], vertex
    dp4 outpos.w, projection[3], vertex
    mov outuv, texcoord
    mov outcolor, color
    end
.end
