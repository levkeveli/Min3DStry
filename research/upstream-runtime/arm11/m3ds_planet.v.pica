; Stock planet vertex colors are computed before submitting the indexed mesh.
.fvec projection[4]
.in vertex v0
.in color v1
.out outpos position
.out outcolor color

.proc main
    dp4 outpos.x, projection[0], vertex
    dp4 outpos.y, projection[1], vertex
    dp4 outpos.z, projection[2], vertex
    dp4 outpos.w, projection[3], vertex
    mov outcolor, color
    end
.end
