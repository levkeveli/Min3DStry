+    // Upstream adds at one end and removes at the other, preserving FIFO order.
+    static final class FlowFrontier{
+        private static final int capacity = 16;
+
+        private static final class Chunk{
+            final int[] tiles = new int[capacity];
+            Chunk next;
+        }
+
+        private Chunk head, tail;
+        private int read, write;
+        int size;
+
+        void addFirst(int tile){
+            if(tail == null || write == capacity){
+                Chunk chunk = new Chunk();
+                if(tail == null) head = chunk;
+                else tail.next = chunk;
+                tail = chunk;
+                write = 0;
+            }
+            tail.tiles[write++] = tile;
+            size++;
+        }
+
+        int removeLast(){
+            if(size == 0) throw new java.util.NoSuchElementException();
+            int tile = head.tiles[read++];
+            if(--size == 0){
+                clear();
+            }else if(read == capacity){
+                head = head.next;
+                read = 0;
+            }
+            return tile;
+        }
+
+        void clear(){
+            head = tail = null;
+            read = write = size = 0;
+        }
+    }
+
+    // Stock uses the ID only to check whether this search has visited a tile.
+    static final class SearchGrid{
+        private static final int wordsPerPage = 16;
+        private static final int pagesPerGroup = 24;
+        private final int[][][] pages;
+
+        SearchGrid(int length){
+            int tilesPerPage = wordsPerPage * Integer.SIZE;
+            int pageCount = (length + tilesPerPage - 1) / tilesPerPage;
+            pages = new int[(pageCount + pagesPerGroup - 1) / pagesPerGroup][][];
+            for(int group = 0; group < pages.length; group++){
+                pages[group] = new int[Math.min(pagesPerGroup, pageCount - group * pagesPerGroup)][];
+            }
+        }
+
+        boolean visited(int index){
+            int word = index >>> 5;
+            int pageIndex = word / wordsPerPage;
+            int[] page = pages[pageIndex / pagesPerGroup][pageIndex % pagesPerGroup];
+            return page != null && (page[word % wordsPerPage] & (1 << (index & 31))) != 0;
+        }
+
+        void visit(int index){
+            int word = index >>> 5;
+            int pageIndex = word / wordsPerPage;
+            int[][] group = pages[pageIndex / pagesPerGroup];
+            int slot = pageIndex % pagesPerGroup;
+            int[] page = group[slot];
+            if(page == null){
+                page = new int[wordsPerPage];
+                group[slot] = page;
+            }
+            page[word % wordsPerPage] |= 1 << (index & 31);
+        }
+
+        void clear(){
+            for(int[][] group : pages){
+                for(int[] page : group){
+                    if(page != null) Arrays.fill(page, 0);
+                }
+            }
+        }
+    }
