+
+    public static final class CostGrid{
+        private static final int chunkSize = 16;
+        private static final int chunksPerPage = 28;
+        public final int length;
+        private static final int pagesPerGroup = 28;
+        private final int[][][][] groups;
+        private final int pageCount;
+        private final int chunkCount;
+        private int defaultValue;
+        private CostGrid snapshot;
+
+        CostGrid(int length){
+            this(length, false);
+        }
+
+        CostGrid(int length, boolean lazy){
+            this.length = length;
+            chunkCount = (length + chunkSize - 1) / chunkSize;
+            pageCount = (chunkCount + chunksPerPage - 1) / chunksPerPage;
+            groups = new int[(pageCount + pagesPerGroup - 1) / pagesPerGroup][][][];
+            for(int group = 0; group < groups.length; group++){
+                groups[group] = new int[Math.min(pagesPerGroup, pageCount - group * pagesPerGroup)][][];
+            }
+            if(!lazy){
+                for(int index = 0; index < pageCount; index++){
+                    int[][] page = allocatePage(index);
+                    for(int slot = 0; slot < page.length; slot++){
+                        int chunk = index * chunksPerPage + slot;
+                        page[slot] = new int[Math.min(chunkSize, length - chunk * chunkSize)];
+                    }
+                }
+            }
+        }
+
+        private int[][] page(int index){
+            return groups[index / pagesPerGroup][index % pagesPerGroup];
+        }
+
+        private void setPage(int index, int[][] page){
+            groups[index / pagesPerGroup][index % pagesPerGroup] = page;
+        }
+
+        private int[][] allocatePage(int index){
+            int[][] page = new int[Math.min(chunksPerPage, chunkCount - index * chunksPerPage)][];
+            setPage(index, page);
+            return page;
+        }
+
+        private int[] chunk(int index){
+            int[][] page = page(index / chunksPerPage);
+            return page == null ? null : page[index % chunksPerPage];
+        }
+
+        public int get(int index){
+            int chunk = index / chunkSize;
+            int[] values = chunk(chunk);
+            return values == null ? defaultValue : values[index % chunkSize];
+        }
+
+        void set(int index, int value){
+            int chunk = index / chunkSize;
+            int pageIndex = chunk / chunksPerPage;
+            int[][] page = page(pageIndex);
+            int slot = chunk % chunksPerPage;
+            int offset = index % chunkSize;
+            int[] values = page == null ? null : page[slot];
+            if((values == null ? defaultValue : values[offset]) == value) return;
+            if(page == null){
+                page = allocatePage(pageIndex);
+            }else if(snapshot != null && snapshot.page(pageIndex) == page){
+                page = page.clone();
+                setPage(pageIndex, page);
+            }
+            if(values == null){
+                values = new int[Math.min(chunkSize, length - chunk * chunkSize)];
+                Arrays.fill(values, defaultValue);
+            }else if(snapshot != null && snapshot.chunk(chunk) == values){
+                values = values.clone();
+            }
+            values[offset] = value;
+            page[slot] = values;
+        }
+
+        void fill(int value){
+            defaultValue = value;
+            for(int pageIndex = 0; pageIndex < pageCount; pageIndex++){
+                int[][] page = page(pageIndex);
+                if(page == null) continue;
+                if(snapshot != null && snapshot.page(pageIndex) == page){
+                    setPage(pageIndex, null);
+                    continue;
+                }
+                for(int slot = 0; slot < page.length; slot++){
+                    int[] values = page[slot];
+                    if(values == null) continue;
+                    if(snapshot != null && snapshot.chunk(pageIndex * chunksPerPage + slot) == values) page[slot] = null;
+                    else Arrays.fill(values, value);
+                }
+            }
+        }
+
+        void copyTo(CostGrid target){
+            // Share both directory pages and their chunks until a working write detaches them.
+            snapshot = target;
+            target.defaultValue = defaultValue;
+            for(int pageIndex = 0; pageIndex < pageCount; pageIndex++){
+                target.setPage(pageIndex, page(pageIndex));
+            }
+        }
+    }

